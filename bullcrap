  if(currentUnit.id==="accel"){
    const time=getAcceleratorTime(tower);

    extra=`
      <br>Charge: <strong>${Math.round(tower.charge / time * 100)}%</strong>
      <br>Beam: <strong>${tower.beam ? "FIRING" : "CHARGING"}</strong>
    `;
  }

  if(currentUnit.id==="engineer"){
    extra=`
      <br>Turrets deployed: <strong>${tower.turrets.length}</strong>
      <br>Path A adds sentry turrets.
      <br>Path B upgrades turrets to miniguns.
