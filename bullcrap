/* ============================================================
   ENEMIES / WAVES
============================================================ */
function normalizeEnemyType(type){
  return ["normal","runner","armored","healer","shield","juggernaut"].includes(type)
    ? type
    : "normal";
}

function getDifficulty(){
  if(state.wave <= 7){
    return 1 + (state.wave-1)*.1;
  }

  const late = state.wave - 7;

  return 1.7 + late*.24 + Math.pow(late,1.22)*.045;
}

function spawnEnemy(type="normal"){
  type=normalizeEnemyType(type);

  const difficulty=getDifficulty();
  const health=(55 + state.wave*17) * difficulty;
  const rewardMultiplier=1 + Math.max(0,state.wave-7) * .18;
  const start=activeMap.path[0];

  const enemy={
    x:start.x,
    y:start.y,
    progress:0,

    hp:health,
    maxHp:health,
    speed:(45 + state.wave*2) * (state.wave > 7 ? 1 + (state.wave-7)*.012 : 1),
    reward:Math.floor((55 + state.wave*6) * rewardMultiplier),

    radius:14,
    color:"#dc2626",
    dead:false,

    armor:0,
    slowTimer:0,
    slowAmount:0,
    freezeTimer:0,
    burnTimer:0,
    burnDamage:0,
    burnTick:0,
    markedTimer:0,
    knockback:0,
    healer:false
  };

  if(type==="runner"){
    enemy.maxHp=health*.55;
    enemy.hp=enemy.maxHp;
    enemy.speed*=10.9;
    enemy.reward=Math.floor(75 * rewardMultiplier);
    enemy.radius=10;
    enemy.color="#f97316";
  }

  if(type==="armored"){
    enemy.maxHp=health*2;
    enemy.hp=enemy.maxHp;
    enemy.speed*=.3;
    enemy.reward=Math.floor(115 * rewardMultiplier);
    enemy.radius=18;
    enemy.color="#64748b";
    enemy.armor=.25;
  }

  if(type==="healer"){
    enemy.maxHp=health*1.3;
    enemy.hp=enemy.maxHp;
    enemy.speed*=.85;
    enemy.reward=Math.floor(125 * rewardMultiplier);
    enemy.radius=15;
    enemy.color="#22c55e";
    enemy.healer=true;
  }

  if(type==="shield"){
    enemy.maxHp=health*1.7;
    enemy.hp=enemy.maxHp;
    enemy.speed*=.78;
    enemy.reward=Math.floor(135 * rewardMultiplier);
    enemy.radius=19;
    enemy.color="#2563eb";
    enemy.armor=.1;
  }

  if(type==="juggernaut"){
    enemy.maxHp=health*4;
    enemy.hp=enemy.maxHp;
    enemy.speed*=.52;
    enemy.reward=Math.floor(240 * rewardMultiplier);
    enemy.radius=24;
    enemy.color="#7c3aed";
    enemy.armor=.35;
  }

  state.enemies.push(enemy);
  addParticles(enemy.x,enemy.y,enemy.color,5,40);
}

function startWave(){
  if(state.waveActive || state.gameOver) return;

  state.waveActive=true;
  state.spawnTimer=0;
  state.queue=[];

  const count =
    state.wave <= 7
      ? 8 + state.wave*3
      : Math.floor(
          29 + (state.wave-7)*4 + Math.pow(state.wave-7,1.3)
        );

  for(let i=0;i<count;i++){
    const roll=Math.random();
    let type="normal";

    if(state.wave >= 6 && roll > .9) type="juggernaut";
    else if(state.wave >= 5 && roll > .78) type="shield";
    else if(state.wave >= 4 && roll > .64) type="healer";
    else if(state.wave >= 3 && roll < .2) type="runner";
    else if(state.wave >= 3 && roll > .7) type="armored";

    state.queue.push(type);
  }

  waveButton.textContent="Wave In Progress";
  waveButton.disabled=true;
}

waveButton.addEventListener("click",startWave);

function getEconomyWavePayout(tower){
  const basePayout=1500;
  const perUpgrade=Math.floor(tower.base / 3);

  let payout = basePayout + Math.max(0, tower.level-1) * perUpgrade;

  if(tower.path === "A"){
    const bonus = getPathBonuses(tower);
    payout += bonus.incomeWave || 0;
  }

  return payout;
}

function updateWave(dt){
  if(!state.waveActive) return;

  state.spawnTimer -= dt;

  if(state.queue.length > 0 && state.spawnTimer <= 0){
    const type=normalizeEnemyType(state.queue.shift());

    try{
      spawnEnemy(type);
    }catch(error){
      console.error("Enemy spawn error:",error);
      spawnEnemy("normal");
    }

    state.spawnTimer = Math.max(.22, .82 - state.wave*.018);
  }

  const enemiesAlive = state.enemies.some(enemy => !enemy.dead);

  if(state.queue.length === 0 && !enemiesAlive){
    state.waveActive=false;

    let payout = 150 + state.wave*55 + Math.max(0,state.wave-7)**2 * 40;

    for(const tower of state.towers){
      if(tower.type === "economy"){
        payout += getEconomyWavePayout(tower);
      }
    }

    state.wave++;
    state.cash += payout;

    addText(110,110,`WAVE BONUS +${payout}g`,"#facc15");

    waveButton.textContent="Start Wave";
    waveButton.disabled=false;
  }
}

/* ============================================================
   AURAS / ECONOMY
============================================================ */
function getAura(tower){
  let speed=0;
  let damageBoost=0;
  let rangeBoost=0;

  for(const other of state.towers){
    if(other===tower) continue;

    if(distance(tower.x,tower.y,other.x,other.y) > 170){
      continue;
    }

    const bonus=getPathBonuses(other);

    if(other.type==="commander"){
      speed += bonus.auraSpeed || 0;
      damageBoost += bonus.auraDamage || 0;
      rangeBoost += bonus.auraRange || 0;
    }

    if(other.type==="support"){
      rangeBoost += bonus.rangeAura || 0;
      damageBoost += bonus.damage || 0;
    }

    if(other.type==="accel" && other.path==="A"){
      speed += bonus.charge || 0;
    }
  }

  return {speed,damage:damageBoost,range:rangeBoost};
}

function updateEconomyTower(tower,dt){
  const bonus=getPathBonuses(tower);

  let interval = 5 / (1 + (tower.level-1)*.12);
  let amount = 35 + 25 * (tower.level-1);

  if(tower.path === "A"){
    amount += 20 * (tower.level-2);
  }

  if(tower.path === "B"){
    interval *= 1 - (bonus.interval || 0);
    amount += bonus.incomeTick || 0;
  }

  tower.incomeTimer -= dt;

  if(tower.incomeTimer <= 0){
    tower.incomeTimer = interval;
    state.cash += amount;
    tower.totalIncome += amount;

    addText(
      tower.x,
      tower.y-28,
      `+${amount}g`,
      "#facc15"
    );

    addRing(
      tower.x,
      tower.y,
      "#facc15",
      5,
      28,
      .25
    );
  }
}

/* ============================================================
   ENGINEER TURRETS
============================================================ */
function createEngineerTurret(engineer,type){
  engineer.turrets.push({
    id:Date.now()+Math.random(),
    type,
    x:engineer.x + (Math.random()-.5)*28,
    y:engineer.y + (Math.random()-.5)*28,
    cooldown:0,
    angle:0,
    recoil:0
  });
}

function updateEngineerTurrets(engineer,dt){
  for(const turret of engineer.turrets){
    turret.cooldown -= dt;

    const config =
      turret.type === "minigun"
        ? {range:135,damage:34,rate:7,color:"#cbd5e1"}
        : {range:105,damage:12,rate:1.4,color:"#86efac"};

    const target = state.enemies
      .filter(enemy =>
        !enemy.dead &&
        distance(turret.x,turret.y,enemy.x,enemy.y) <= config.range
      )
      .sort((a,b)=>b.progress-a.progress)[0];

    if(!target) continue;

    turret.angle = Math.atan2(
      target.y - turret.y,
      target.x - turret.x
    );

    if(turret.cooldown <= 0){
      turret.cooldown = 1 / config.rate;
      turret.recoil = .12;

      damageEnemy(target,config.damage,config.color);

      addLine(
        turret.x,
        turret.y,
        target.x,
        target.y,
        config.color,
        .08,
        turret.type === "minigun" ? 3 : 2
      );
    }
  }
}

/* ============================================================
   SPECIAL TOWER SYSTEMS
============================================================ */
function permafrostHit(tower,enemy){
  const hits=(tower.hits.get(enemy.id)||0)+1;

  if(hits >= 12){
    tower.hits.set(enemy.id,0);

    enemy.freezeTimer=2;
    addRing(enemy.x,enemy.y,"#bae6fd",5,30,.35);
    addText(enemy.x,enemy.y-32,"FROZEN","#bae6fd");
  }else{
    tower.hits.set(enemy.id,hits);
  }
}

function firePermafrostShot(tower,stats,target){
  tower.angle = Math.atan2(
    target.y - tower.y,
    target.x - tower.x
  );

  tower.shots++;

  damageEnemy(target,stats.damage,"#a5f3fc");
  target.slowTimer=1.3;
  target.slowAmount=.78;
  permafrostHit(tower,target);

  addLine(
    tower.x,
    tower.y,
    target.x,
    target.y,
    "#67e8f9",
    .1,
    3
  );

  if(
    tower.path === "A" &&
    tower.level >= 5 &&
    tower.shots % 24 === 0
  ){
    const radius = 75 + (tower.level-1)*8;

    addRing(target.x,target.y,"#67e8f9",8,radius,.5);

    for(const enemy of state.enemies){
      if(!enemy.dead && distance(target.x,target.y,enemy.x,enemy.y) <= radius){
        enemy.freezeTimer=2;
      }
    }

    addText(target.x,target.y-42,"FREEZE BOMB","#67e8f9");
  }
}

function updatePermafrost(tower,dt,stats){
  const list=getTargets(tower,stats.range);

  tower.cooldown -= dt;
  tower.burstTimer -= dt;

  if(tower.burst > 0 && tower.burstTimer <= 0){
    if(!list.length){
      tower.burst=0;
      return;
    }

    firePermafrostShot(tower,stats,list[0]);
    tower.burst--;

    if(tower.burst > 0){
      tower.burstTimer = .12;
    }

    return;
  }

  if(tower.cooldown <= 0 && list.length){
    const automatic = tower.path === "B" && tower.level >= 5;

    if(automatic){
      firePermafrostShot(tower,stats,list[0]);
      tower.cooldown = 1 / (stats.rate * 1.15);
    }else{
      tower.burst=2;
      tower.burstTimer=0;
      tower.cooldown = 1 / stats.rate;
    }
  }
}

function fireSpikeShooter(tower,stats){
  tower.spin += .35;

  const range=stats.range * (tower.level >= 4 ? .76 : 1);
  const rays=tower.level >= 5 ? 6 : tower.level >= 4 ? 8 : 10;
  const multiplier=tower.level >= 5 ? .72 : tower.level >= 4 ? .8 : 1;

  for(let i=0;i<rays;i++){
    const angle = tower.spin + i*Math.PI*2/rays;
    const endX = tower.x + Math.cos(angle) * range;
    const endY = tower.y + Math.sin(angle) * range;

    addLine(tower.x,tower.y,endX,endY,"#fb7185",.12,3);

    for(const enemy of state.enemies){
      if(enemy.dead) continue;

      const dx=enemy.x - tower.x;
      const dy=enemy.y - tower.y;
      const enemyDistance=Math.hypot(dx,dy);

      if(enemyDistance > range) continue;

      let difference=Math.abs(Math.atan2(dy,dx)-angle);

      if(difference > Math.PI){
        difference = Math.PI*2 - difference;
      }

      if(difference < .18){
        const value = stats.damage * multiplier;
        damageEnemy(enemy,value,"#fb7185");

        if(tower.path === "B" && tower.level >= 3){
          enemy.burnTimer=2;
          enemy.burnDamage=value*.25;
        }
      }
    }
  }

  addRing(tower.x,tower.y,"#fb7185",8,range,.18);
}

function updateAccelerator(tower,dt,stats,aura){
  const range=stats.range + aura.range;
  const list=getTargets(tower,range);

  if(!list.length){
    tower.beam=false;
    tower.beamTarget=null;
    tower.charge = Math.max(0,tower.charge-dt*.35);
    return;
  }

  if(
    !tower.beamTarget ||
    tower.beamTarget.dead ||
    distance(tower.x,tower.y,tower.beamTarget.x,tower.beamTarget.y) > range
  ){
    tower.beamTarget = list[0];
    tower.beam = false;
  }

  const time = getAcceleratorTime(tower);
  const chargeRate = 1 + (stats.bonus.charge || 0) + aura.speed*.3;

  if(!tower.beam){
    tower.charge += dt * chargeRate;

    if(tower.charge >= time){
      tower.charge = time;
      tower.beam = true;

      addText(tower.x,tower.y-32,"BEAM READY","#c4b5fd");
      addRing(tower.x,tower.y,"#c084fc",10,70,.35);
    }

    return;
  }

  const target=tower.beamTarget;

  if(!target || target.dead){
    tower.beam=false;
    tower.charge=0;
    tower.beamTarget=null;
    return;
  }

  tower.angle=Math.atan2(target.y-tower.y,target.x-tower.x);

  damageEnemy(
    target,
    stats.damage * 1.5 * (1 + (stats.bonus.damage || 0)) * dt,
    "#d8b4fe",
    true
  );

  addLine(
    tower.x,
    tower.y,
    target.x,
    target.y,
    tower.path === "B" ? "#f43f5e" : "#c084fc",
    .08,
    tower.level >= 5 ? 12 : 7
  );

  if(tower.path === "B"){
    target.slowTimer=.2;
    target.slowAmount = stats.bonus.slow ? .25 : .5;
  }
}

/* ============================================================
   ATTACKS
============================================================ */
function fireNormalTower(tower,stats,list){
  const currentUnit=stats.unit;
  const bonus=stats.bonus;
  const target=list[0];

  tower.attacks++;
  tower.angle = Math.atan2(target.y - tower.y, target.x - tower.x);
  muzzleFlash(tower);

  if(currentUnit.id === "engineer"){
    damageEnemy(target,stats.damage,"#facc15");

    if(tower.turrets.length === 0){
      createEngineerTurret(tower,"sentry");
      addText(tower.x,tower.y-30,"SENTRY DEPLOYED","#86efac");
    }

    if(tower.path === "A" && tower.level >= 3 && tower.turrets.length < 2){
      createEngineerTurret(tower,"sentry");
      addText(tower.x,tower.y-30,"SECOND SENTRY","#86efac");
    }

    if(tower.path === "B" && tower.level >= 3){
      tower.turrets.forEach(turret => { turret.type = "minigun"; });
    }

    return;
  }

  if(currentUnit.id === "spike"){
    fireSpikeShooter(tower,stats);
    return;
  }

  if(currentUnit.id === "rifle"){
    if(tower.path === "A" && tower.level >= 5 && tower.attacks % 3 === 0){
      damageEnemy(target,stats.damage*3,"#fef08a",true);
    }else if(tower.path === "B" && tower.level >= 5){
      list.slice(0,3).forEach(enemy => {
        damageEnemy(enemy,stats.damage*.8,"#fde68a");
      });
    }else{
      damageEnemy(target,stats.damage,"#fde68a");
    }
  }

  if(currentUnit.id === "flame"){
    const cone=.6 + (bonus.cone || 0);

    list.forEach(enemy => {
      let angle=Math.abs(
        Math.atan2(enemy.y-tower.y, enemy.x-tower.x) - tower.angle
      );
      if(angle > Math.PI) angle = Math.PI*2 - angle;

      if(angle < cone){
        damageEnemy(enemy,stats.damage,"#fb923c");

        enemy.burnTimer = 1.2 + (bonus.burn || 0);
        enemy.burnDamage = stats.damage * .45;

        if(bonus.knockback){
          enemy.knockback = 24;
        }
      }
    });

    state.effects.push({
      type:"flame",
      x:tower.x,
      y:tower.y,
      angle:tower.angle,
      range:stats.range,
      cone,
      life:.1,
      maxLife:.1,
      color:"#fb923c"
    });
  }

  if(currentUnit.id === "shot"){
    const pellets = 5 + (bonus.pellets || 0);

    if(tower.path === "B" && tower.level >= 5){
      damageEnemy(target,stats.damage*4,"#d8b4fe",true);

      addLine(
        tower.x,tower.y,
        target.x,target.y,
        "#d8b4fe",
        .2,
        7
      );
    }else{
      list.slice(0,3).forEach(enemy => {
        damageEnemy(enemy,stats.damage*pellets/3,"#d8b4fe");
      });
    }
  }

  if(currentUnit.id === "mini"){
    damageEnemy(target,stats.damage,"#e2e8f0", tower.path === "A" && tower.level >= 4);

    addLine(
      tower.x,tower.y,
      target.x,target.y,
      "#cbd5e1",
      .06,
      2
    );

    if(bonus.slow){
      list.slice(0,5).forEach(enemy => {
        enemy.slowTimer=1.1;
        enemy.slowAmount=.58;
      });
    }
  }

  if(currentUnit.id === "rocket"){
    const radius=65 + (bonus.splash || 0);

    damageEnemy(target,stats.damage,"#fb923c");
    addRing(target.x,target.y,"#fb923c",5,radius,.35);

    state.enemies.forEach(enemy => {
      if(enemy !== target && !enemy.dead && distance(target.x,target.y,enemy.x,enemy.y) < radius){
        damageEnemy(enemy,stats.damage*.55,"#fb923c");
      }
    });

    if(tower.path === "B" && tower.level >= 5){
      list.slice(1,4).forEach(enemy => {
        damageEnemy(enemy,stats.damage*.5,"#fdba74");
      });
    }
  }

  if(currentUnit.id === "mortar"){
    const radius=82 + (bonus.splash || 0);
    const shots = (bonus.barrage && tower.attacks % 3 === 0) ? 2 : 1;

    for(let i=0;i<shots;i++){
      damageEnemy(target,stats.damage,"#a16207");
      addRing(target.x,target.y,"#a16207",5,radius,.4);

      state.enemies.forEach(enemy => {
        if(enemy !== target && !enemy.dead && distance(target.x,target.y,enemy.x,enemy.y) < radius){
          damageEnemy(enemy,stats.damage*.55,"#a16207");
        }
      });
    }

    if(bonus.crater){
      state.enemies.forEach(enemy => {
        if(distance(target.x,target.y,enemy.x,enemy.y) < radius){
          enemy.burnTimer=3;
          enemy.burnDamage=stats.damage*.3;
        }
      });
    }
  }

  if(currentUnit.id === "tesla"){
    let previous={x:tower.x,y:tower.y};
    let amount=stats.damage;
    const chain=3 + (bonus.chain || 0);

    list.slice(0,chain).forEach(enemy => {
      damageEnemy(enemy,amount,"#67e8f9");

      addLine(
        previous.x,
        previous.y,
        enemy.x,
        enemy.y,
        "#67e8f9",
        .22,
        5
      );

      if(bonus.freeze){
        enemy.freezeTimer = bonus.freeze;
      }

      previous=enemy;
      amount *= .72;
    });
  }

  if(currentUnit.id === "sniper"){
    const critical = Math.random() < .42 + (bonus.crit || 0);
    const amount = critical ? stats.damage*2.5 : stats.damage;

    damageEnemy(target,amount, critical ? "#fef08a" : "#34d399");

    addLine(
      tower.x,
      tower.y,
      target.x,
      target.y,
      critical ? "#fef08a" : "#6ee7b7",
      .25,
      critical ? 7 : 4
    );

    if(tower.path === "A" && tower.level >= 5 && critical && target.hp < target.maxHp*.4){
      damageEnemy(target,target.hp+9999,"#fef08a",true);
      addText(target.x,target.y-35,"EXECUTE","#fef08a");
    }

    if(bonus.mark){
      target.markedTimer=bonus.mark;
    }
  }

  if(currentUnit.id === "commander"){
    damageEnemy(target,stats.damage,"#fde047");
  }

  if(currentUnit.id === "support"){
    damageEnemy(target,stats.damage,"#f0abfc");
  }

  if(currentUnit.id === "rail"){
    damageEnemy(target,stats.damage,"#fb7185", !!bonus.pierce);

    addLine(
      tower.x,tower.y,
      target.x,target.y,
      "#fb7185",
      .3,
      7
    );

    if(bonus.pierce){
      state.enemies.forEach(enemy => {
        if(enemy !== target && !enemy.dead && distance(tower.x,tower.y,enemy.x,enemy.y) < stats.range){
          damageEnemy(enemy,stats.damage*.75,"#fb7185",true);
        }
      });
    }

    if(bonus.knock){
      state.enemies.forEach(enemy => {
        if(distance(target.x,target.y,enemy.x,enemy.y) < 100){
          enemy.knockback = bonus.knock;
        }
      });
    }
  }

  if(currentUnit.id === "air"){
    const bombs = bonus.bombs || 1;

    for(let i=0;i<bombs;i++){
      const x = target.x + random(-48,48);
      const y = target.y + random(-48,48);

      addRing(x,y,"#93c5fd",5,70,.4);

      state.enemies.forEach(enemy => {
        if(distance(x,y,enemy.x,enemy.y) < 70){
          damageEnemy(enemy,stats.damage,"#93c5fd");

          if(bonus.burn){
            enemy.burnTimer = bonus.burn;
            enemy.burnDamage = stats.damage * .35;
          }
        }
      });
    }
  }
}

/* ============================================================
   TOWER UPDATE
============================================================ */
function getTargets(tower,range){
  return state.enemies
    .filter(enemy =>
      !enemy.dead &&
      distance(tower.x,tower.y,enemy.x,enemy.y) <= range
    )
    .sort((a,b) => b.progress - a.progress);
}

function updateTowers(dt){
  for(const tower of state.towers){
    const stats=getStats(tower);
    const aura=getAura(tower);

    if(tower.recoil > 0){
      tower.recoil -= dt;
    }

    if(tower.type === "economy"){
      updateEconomyTower(tower,dt);
      continue;
    }

    if(tower.type === "engineer"){
      tower.cooldown -= dt;

      if(tower.cooldown <= 0){
        tower.cooldown = 1 / (stats.rate * (1 + aura.speed));

        const list = getTargets(tower, stats.range + aura.range);

        if(list.length){
          fireNormalTower(
            tower,
            {
              ...stats,
              range:stats.range + aura.range,
              damage:stats.damage * (1 + aura.damage)
            },
            list
          );
        }
      }

      updateEngineerTurrets(tower,dt);
      continue;
    }

    if(tower.type === "frost"){
      updatePermafrost(tower,dt,stats);
      continue;
    }

    if(tower.type === "accel"){
      updateAccelerator(
        tower,
        dt,
        {
          ...stats,
          range:stats.range + aura.range,
          damage:stats.damage * (1 + aura.damage)
        },
        aura
      );
      continue;
    }

    tower.cooldown -= dt;

    if(tower.cooldown <= 0){
      tower.cooldown = 1 / (stats.rate * (1 + aura.speed));

      const list=getTargets(tower, stats.range + aura.range);

      if(list.length){
        fireNormalTower(
          tower,
          {
            ...stats,
            range:stats.range + aura.range,
            damage:stats.damage * (1 + aura.damage)
          },
          list
        );
      }
    }
  }
}

/* ============================================================
   ENEMY UPDATE
============================================================ */
function updateEnemies(dt){
  for(let i=state.enemies.length-1;i>=0;i--){
    const enemy=state.enemies[i];

    if(enemy.dead){
      state.enemies.splice(i,1);
      continue;
    }

    if(enemy.healer){
      state.enemies.forEach(other => {
        if(
          other !== enemy &&
          !other.dead &&
          distance(enemy.x,enemy.y,other.x,other.y) < 75
        ){
          other.hp = Math.min(other.maxHp, other.hp + dt*4);
        }
      });
    }

    if(enemy.freezeTimer > 0) enemy.freezeTimer -= dt;
    if(enemy.slowTimer > 0) enemy.slowTimer -= dt;
    if(enemy.markedTimer > 0) enemy.markedTimer -= dt;

    if(enemy.burnTimer > 0){
      enemy.burnTimer -= dt;
      enemy.burnTick -= dt;

      if(enemy.burnTick <= 0){
        enemy.burnTick = .35;
        damageEnemy(enemy,enemy.burnDamage,"#fb923c");
        addParticles(enemy.x,enemy.y,"#f97316",3,45);
      }
    }

    let speedMultiplier=1;

    if(enemy.freezeTimer > 0){
      speedMultiplier = 0;
    }else if(enemy.slowTimer > 0){
      speedMultiplier = enemy.slowAmount;
    }

    if(enemy.knockback > 0){
      enemy.progress = Math.max(0, enemy.progress - enemy.knockback*dt);
      enemy.knockback -= dt*22;
    }

    enemy.progress += enemy.speed * speedMultiplier * dt;

    const pos = pathPosition(enemy.progress);
    enemy.x = pos.x;
    enemy.y = pos.y;

    if(enemy.progress >= pathLength){
      state.enemies.splice(i,1);
      state.lives--;

      addText(board.width-80,180,"-1 life","#ef4444");

      if(state.lives <= 0){
        endGame();
      }
    }
  }
}

/* ============================================================
   EFFECTS / PARTICLES / TEXTS
============================================================ */
function updateEffects(dt){
  for(let i=state.effects.length-1;i>=0;i--){
    const effect=state.effects[i];

    effect.life -= dt;

    if(effect.type === "ring"){
      const progress = 1 - effect.life / effect.maxLife;
      effect.radius = effect.start + (effect.end - effect.start) * progress;
    }

    if(effect.life <= 0){
      state.effects.splice(i,1);
    }
  }

  for(let i=state.particles.length-1;i>=0;i--){
    const particle=state.particles[i];

    particle.life -= dt;
    particle.x += particle.vx * dt;
    particle.y += particle.vy * dt;
    particle.vx *= .96;
    particle.vy *= .96;

    if(particle.life <= 0){
      state.particles.splice(i,1);
    }
  }

  for(let i=state.texts.length-1;i>=0;i--){
    const item=state.texts[i];

    item.life -= dt;
    item.y -= 24 * dt;

    if(item.life <= 0){
      state.texts.splice(i,1);
    }
  }
}

/* ============================================================
   DRAWING
============================================================ */
function drawBackground(){
  ctx.fillStyle="#101912";
  ctx.fillRect(0,0,board.width,board.height);

  ctx.strokeStyle="#b4c8aa0f";
  ctx.lineWidth=1;

  for(let x=0;x<=board.width;x+=40){
    ctx.beginPath();
    ctx.moveTo(x,0);
    ctx.lineTo(x,board.height);
    ctx.stroke();
  }

  for(let y=0;y<=board.height;y+=40){
    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(board.width,y);
    ctx.stroke();
  }
}

function drawPath(){
  ctx.beginPath();
  ctx.moveTo(activeMap.path[0].x, activeMap.path[0].y);

  for(let i=1;i<activeMap.path.length;i++){
    ctx.lineTo(activeMap.path[i].x, activeMap.path[i].y);
  }

  ctx.lineCap="round";
  ctx.lineJoin="round";

  ctx.lineWidth=46;
  ctx.strokeStyle="#34452f";
  ctx.stroke();

  ctx.lineWidth=34;
  ctx.strokeStyle=activeMap.color;
  ctx.stroke();

  ctx.lineWidth=22;
  ctx.strokeStyle="#4b5939";
  ctx.stroke();

  for(const obstacle of activeMap.obstacles){
    ctx.fillStyle="#7f2d2d";
    ctx.fillRect(obstacle.x, obstacle.y, obstacle.w, obstacle.h);

    ctx.strokeStyle="#ef4444";
    ctx.lineWidth=2;
    ctx.strokeRect(obstacle.x, obstacle.y, obstacle.w, obstacle.h);
  }
}

function drawTower(tower){
  const stats=getStats(tower);
  const currentUnit=stats.unit;

  const recoil = tower.recoil > 0 ? 5 : 0;
  const shakeX = tower.recoil > 0 ? random(-2,2) : 0;
  const shakeY = tower.recoil > 0 ? random(-2,2) : 0;
  const rotation = tower.recoil > 0 ? random(-.06,.06) : 0;

  if(state.selectedTower === tower){
    ctx.beginPath();
    ctx.strokeStyle="#ffffffb8";
    ctx.lineWidth=2;
    ctx.arc(tower.x,tower.y,stats.range,0,Math.PI*2);
    ctx.stroke();
  }

  if(tower.level >= 5){
    const gradient=ctx.createLinearGradient(tower.x-28,tower.y-28,tower.x+28,tower.y+28);
    const hue=performance.now()/5;

    gradient.addColorStop(0, `hsl(${hue%360},100%,65%)`);
    gradient.addColorStop(.5, "#fef08a");
    gradient.addColorStop(1, `hsl(${(hue+180)%360},100%,65%)`);

    ctx.beginPath();
    ctx.strokeStyle=gradient;
    ctx.lineWidth=5;
    ctx.shadowColor="#c084fc";
    ctx.shadowBlur=14;
    ctx.arc(tower.x,tower.y,27,0,Math.PI*2);
    ctx.stroke();
    ctx.shadowBlur=0;
  }

  ctx.save();
  ctx.translate(tower.x + shakeX, tower.y + shakeY);
  ctx.rotate(tower.angle + rotation);

  ctx.fillStyle=currentUnit.color;
  ctx.strokeStyle="#fff";
  ctx.lineWidth=2;

  if(currentUnit.shape === "diamond"){
    ctx.beginPath();
    ctx.moveTo(0,-17);
    ctx.lineTo(17,0);
    ctx.lineTo(0,17);
    ctx.lineTo(-17,0);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "triangle"){
    ctx.beginPath();
    ctx.moveTo(17,0);
    ctx.lineTo(-17,-17);
    ctx.lineTo(-17,17);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "circle"){
    ctx.beginPath();
    ctx.arc(0,0,17,0,Math.PI*2);
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "hex"){
    ctx.beginPath();
    for(let i=0;i<6;i++){
      const angle=i*Math.PI/3;
      const x=Math.cos(angle)*17;
      const y=Math.sin(angle)*17;

      if(i===0) ctx.moveTo(x,y);
      else ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "star"){
    ctx.beginPath();
    for(let i=0;i<10;i++){
      const radius=i % 2 ? 8 : 17;
      const angle=-Math.PI/2 + i*Math.PI/5;
      const x=Math.cos(angle)*radius;
      const y=Math.sin(angle)*radius;

      if(i===0) ctx.moveTo(x,y);
      else ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "shield"){
    ctx.beginPath();
    ctx.moveTo(-17,-17);
    ctx.lineTo(17,-17);
    ctx.lineTo(17,3);
    ctx.lineTo(0,22);
    ctx.lineTo(-17,3);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "cross"){
    ctx.fillRect(-5,-17,10,34);
    ctx.fillRect(-17,-5,34,10);
  }else if(currentUnit.shape === "long"){
    ctx.fillRect(-17,-7,34,14);
    ctx.strokeRect(-17,-7,34,14);
  }else if(currentUnit.shape === "cone"){
    ctx.beginPath();
    ctx.moveTo(17,0);
    ctx.lineTo(-17,-12);
    ctx.lineTo(-17,12);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "crystal"){
    ctx.beginPath();
    ctx.moveTo(0,-21);
    ctx.lineTo(12,-4);
    ctx.lineTo(17,17);
    ctx.lineTo(0,10);
    ctx.lineTo(-17,17);
    ctx.lineTo(-12,-4);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }else if(currentUnit.shape === "spike"){
    ctx.beginPath();
    ctx.arc(0,0,11,0,Math.PI*2);
    ctx.fill();
    ctx.stroke();

    for(let i=0;i<8;i++){
      const angle=i*Math.PI/4;
      ctx.beginPath();
      ctx.moveTo(Math.cos(angle)*8,Math.sin(angle)*8);
      ctx.lineTo(Math.cos(angle)*27,Math.sin(angle)*27);
      ctx.stroke();
    }
  }else if(currentUnit.shape === "accel"){
    ctx.beginPath();
    ctx.arc(0,0,17,0,Math.PI*2);
    ctx.fill();
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(0,0,8,0,Math.PI*1.6);
    ctx.stroke();
  }else if(currentUnit.shape === "rail"){
    ctx.fillRect(-17,-10,26,20);
    ctx.strokeRect(-17,-10,26,20);
  }else if(currentUnit.shape === "radio"){
    ctx.fillRect(-17,-17,34,34);
    ctx.strokeRect(-17,-17,34,34);

    ctx.beginPath();
    ctx.arc(0,0,9,0,Math.PI*2);
    ctx.stroke();
  }else if(currentUnit.shape === "money"){
    ctx.beginPath();
    ctx.arc(0,0,17,0,Math.PI*2);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle="#111";
    ctx.font="bold 18px Arial";
    ctx.textAlign="center";
    ctx.fillText("$",0,6);
  }else if(currentUnit.shape === "gear"){
    ctx.beginPath();
    for(let i=0;i<16;i++){
      const radius=i % 2 ? 12 : 18;
      const angle=i*Math.PI/8;
      const x=Math.cos(angle)*radius;
      const y=Math.sin(angle)*radius;

      if(i===0) ctx.moveTo(x,y);
      else ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }

  if(!["spike","accel","rail","radio","money"].includes(currentUnit.shape)){
    ctx.fillStyle="#ffffffcc";
    ctx.fillRect(2,-3,21-recoil,6);
  }

  if(tower.path === "A"){
    ctx.strokeStyle="#fef08a";
    ctx.strokeRect(-14,-14,28,5);
  }

  if(tower.path === "B"){
    ctx.strokeStyle="#86efac";
    ctx.strokeRect(-13,8,26,5);
  }

  ctx.restore();

  if(currentUnit.id === "accel"){
    const progress=clamp(tower.charge/getAcceleratorTime(tower),0,1);

    ctx.beginPath();
    ctx.strokeStyle = tower.beam ? "#fef08a" : "#c084fc";
    ctx.lineWidth=4;

    ctx.arc(
      tower.x,
      tower.y,
      25,
      -Math.PI/2,
      -Math.PI/2 + Math.PI*2*progress
    );

    ctx.stroke();
  }

  if(currentUnit.id === "economy"){
    ctx.strokeStyle="#facc15";
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(tower.x,tower.y,23,0,Math.PI*2);
    ctx.stroke();
  }

  if(tower.type === "engineer"){
    for(const turret of tower.turrets){
      ctx.save();
      ctx.translate(turret.x,turret.y);
      ctx.rotate(turret.angle);

      ctx.fillStyle = turret.type === "minigun" ? "#cbd5e1" : "#86efac";
      ctx.strokeStyle="#fff";
      ctx.lineWidth=1;
      ctx.fillRect(-8,-8,16,16);
      ctx.strokeRect(-8,-8,16,16);

      ctx.fillStyle="#ffffffaa";
      ctx.fillRect(3,-2,14-(turret.recoil > 0 ? 3 : 0),4);

      ctx.restore();
    }
  }

  ctx.fillStyle="#101510";
  ctx.beginPath();
  ctx.arc(tower.x + shakeX, tower.y + shakeY, 8, 0, Math.PI*2);
  ctx.fill();

  ctx.fillStyle="#fff";
  ctx.font="bold 10px Arial";
  ctx.textAlign="center";
  ctx.fillText(tower.level, tower.x + shakeX, tower.y + shakeY + 4);

  if(tower.path){
    ctx.fillStyle = tower.path === "A" ? "#c4b5fd" : "#f0abfc";
    ctx.fillText(tower.path, tower.x + shakeX, tower.y + shakeY - 23);
  }

  ctx.textAlign="left";
}

function drawEnemies(){
  for(const enemy of state.enemies){
    if(enemy.dead) continue;

    ctx.beginPath();
    ctx.fillStyle=enemy.color;
    ctx.arc(enemy.x,enemy.y,enemy.radius,0,Math.PI*2);
    ctx.fill();

    ctx.strokeStyle =
      enemy.freezeTimer > 0 ? "#dbeafe" :
      enemy.slowTimer > 0 ? "#93c5fd" :
      "#fff";

    ctx.lineWidth = enemy.freezeTimer > 0 ? 4 : 1;
    ctx.stroke();

    const width=enemy.radius*2.5;
    const x=enemy.x-width/2;
    const y=enemy.y-enemy.radius-11;

    ctx.fillStyle="#000b";
    ctx.fillRect(x,y,width,5);

    ctx.fillStyle="#22c55e";
    ctx.fillRect(x,y,width * clamp(enemy.hp/enemy.maxHp,0,1),5);

    if(enemy.freezeTimer > 0){
      ctx.fillStyle="#bae6fd";
      ctx.beginPath();
      ctx.arc(enemy.x+6, enemy.y-6, 4, 0, Math.PI*2);
      ctx.fill();
    }

    if(enemy.healer){
      ctx.fillStyle="#dcfce7";
      ctx.fillRect(enemy.x-3, enemy.y-9, 6, 18);
      ctx.fillRect(enemy.x-9, enemy.y-3, 18, 6);
    }
  }
}

function drawEffects(){
  for(const effect of state.effects){
    ctx.save();
    ctx.globalAlpha = clamp(effect.life / effect.maxLife, 0, 1);

    if(effect.type === "ring"){
      ctx.beginPath();
      ctx.strokeStyle=effect.color;
      ctx.lineWidth=4;
      ctx.arc(effect.x,effect.y,effect.radius,0,Math.PI*2);
      ctx.stroke();
    }

    if(effect.type === "line"){
      ctx.beginPath();
      ctx.strokeStyle=effect.color;
      ctx.shadowColor=effect.color;
      ctx.shadowBlur=16;
      ctx.lineWidth=effect.width;
      ctx.moveTo(effect.x1,effect.y1);
      ctx.lineTo(effect.x2,effect.y2);
      ctx.stroke();
    }

    if(effect.type === "muzzle"){
      ctx.fillStyle=effect.color;
      ctx.shadowColor=effect.color;
      ctx.shadowBlur=15;

      ctx.beginPath();
      ctx.arc(effect.x,effect.y,6,0,Math.PI*2);
      ctx.fill();
    }

    if(effect.type === "flame"){
      ctx.beginPath();
      ctx.moveTo(effect.x,effect.y);
      ctx.arc(effect.x,effect.y,effect.range,effect.angle-effect.cone,effect.angle+effect.cone);
      ctx.closePath();

      ctx.fillStyle="#f9731666";
      ctx.fill();

      ctx.strokeStyle="#fb923c";
      ctx.lineWidth=3;
      ctx.stroke();
    }

    ctx.restore();
  }
}

function drawParticles(){
  for(const particle of state.particles){
    ctx.save();
    ctx.globalAlpha = clamp(particle.life / particle.maxLife,0,1);
    ctx.fillStyle=particle.color;

    ctx.beginPath();
    ctx.arc(particle.x,particle.y,particle.radius,0,Math.PI*2);
    ctx.fill();
    ctx.restore();
  }
}

function drawTexts(){
  for(const item of state.texts){
    ctx.save();
    ctx.globalAlpha = clamp(item.life / item.maxLife,0,1);
    ctx.fillStyle=item.color;
    ctx.font="bold 13px Arial";
    ctx.textAlign="center";
    ctx.fillText(item.value,item.x,item.y);
    ctx.restore();
  }

  ctx.textAlign="left";
}

function drawHint(){
  if(!state.buildType) return;

  ctx.fillStyle="#000a";
  ctx.fillRect(0,0,board.width,35);

  ctx.fillStyle="#fff";
  ctx.font="bold 14px Arial";
  ctx.fillText(
    `Deploying ${getUnit(state.buildType).name} — click an empty location`,
    14,
    23
  );
}

function render(){
  drawBackground();
  drawPath();

  for(const tower of state.towers){
    drawTower(tower);
  }

  drawEnemies();
  drawEffects();
  drawParticles();
  drawTexts();
  drawHint();
}

/* ============================================================
   HUD / GAME LOOP
============================================================ */
function updateHUD(){
  moneyText.textContent = Math.floor(state.cash);
  lifeText.textContent = state.lives;
  waveText.textContent = state.wave;
  speedText.textContent = `${state.speed}×`;

  updateTowerPanel();
}

speedButton.addEventListener("click",()=>{
  state.speed = state.speed === 1 ? 2 : 1;

  speedButton.classList.toggle("active", state.speed === 2);
  speedButton.textContent = state.speed === 2 ? "1× Speed" : "2× Speed";

  updateHUD();
});

function endGame(){
  if(state.gameOver) return;

  state.gameOver=true;

  setTimeout(()=>{
    alert(`Mission failed! You reached wave ${state.wave}.`);

    state.cash=450;
    state.lives=20;
    state.wave=1;
    state.speed=1;

    state.towers=[];
    state.enemies=[];
    state.effects=[];
    state.particles=[];
    state.texts=[];
    state.queue=[];
    state.waveActive=false;
    state.buildType=null;
    state.selectedTower=null;
    state.chosen=[];
    state.gameOver=false;

    gameScreen.style.display="none";
    selectScreen.style.display="block";

    renderMaps();
    renderUnits();
  },100);
}

function gameLoop(timestamp){
  const rawDelta = state.lastTime ? (timestamp - state.lastTime)/1000 : .016;
  state.lastTime = timestamp;

  const delta = Math.min(rawDelta,.05) * state.speed;

  if(!state.gameOver && gameScreen.style.display === "block"){
    try{
      updateWave(delta);
      updateTowers(delta);
      updateEnemies(delta);
      updateEffects(delta);
      updateHUD();
      render();
    }catch(error){
      console.error("Game runtime error:", error);
      state.effects.length = 0;
      state.particles.length = 0;
      state.texts.length = 0;
    }
  }

  requestAnimationFrame(gameLoop);
}

rebuildPath();
renderMaps();
renderUnits();
requestAnimationFrame(gameLoop);
</script>
