  towerInfo.innerHTML=`
    <strong style="color:${currentUnit.color}">
      ${currentUnit.name} — Level ${tower.level}
    </strong><br>
    Role: <strong>${currentUnit.role}</strong><br>
    Damage: <strong>${Math.round(stats.damage)}</strong><br>
    Range: <strong>${Math.round(stats.range)}</strong><br>
    Fire rate: <strong>${stats.rate.toFixed(2)}/s</strong><br>
    Path: <strong>${tower.path || "None"}</strong>
