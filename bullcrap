/* ============================================================
   DOM / STATE
============================================================ */
const $=id=>document.getElementById(id);

const selectScreen=$("selectScreen");
const gameScreen=$("gameScreen");
const mapGrid=$("mapGrid");
const unitGrid=$("unitGrid");
const selectionCount=$("selectionCount");
const startButton=$("startButton");

const buildList=$("buildList");
const towerInfoPanel=$("towerInfoPanel");
const towerInfo=$("towerInfo");
const pathAButton=$("pathAButton");
const pathBButton=$("pathBButton");
const upgradeButton=$("upgradeButton");
const sellButton=$("sellButton");

const moneyText=$("moneyText");
const lifeText=$("lifeText");
const waveText=$("waveText");
const speedText=$("speedText");
const speedButton=$("speedButton");
const waveButton=$("waveButton");

const board=$("board");
const ctx=board.getContext("2d");

const state={
  mapId:"valley",
  chosen:[],
  buildType:null,
  selectedTower:null,

  cash:450,
  lives:20,
  wave:1,
  speed:1,

  towers:[],
  enemies:[],
  effects:[],
  particles:[],
  texts:[],

  queue:[],
  spawnTimer:0,
  waveActive:false,
  gameOver:false,
  lastTime:0
};

let activeMap=MAPS[0];
let pathLength=0;

/* ============================================================
   HELPER FUNCTIONS
============================================================ */
function getUnit(id){
  return UNITS.find(unit=>unit.id===id);
}

function distance(x1,y1,x2,y2){
  return Math.hypot(x2-x1,y2-y1);
}

function clamp(value,min,max){
  return Math.max(min,Math.min(max,value));
}

function random(min,max){
  return Math.random()*(max-min)+min;
}

function rebuildPath(){
  activeMap=MAPS.find(map=>map.id===state.mapId)||MAPS[0];
  pathLength=0;

  for(let i=0;i<activeMap.path.length-1;i++){
    const a=activeMap.path[i];
    const b=activeMap.path[i+1];
    pathLength+=Math.hypot(b.x-a.x,b.y-a.y);
  }
}

function pathPosition(progress){
  const path=activeMap.path;

  if(progress<=0) return {...path[0]};
  if(progress>=pathLength) return {...path[path.length-1]};

  let travelled=0;

  for(let i=0;i<path.length-1;i++){
    const a=path[i];
    const b=path[i+1];
    const segment=Math.hypot(b.x-a.x,b.y-a.y);

    if(progress<=travelled+segment){
      const ratio=(progress-travelled)/segment;
      return {
        x:a.x+(b.x-a.x)*ratio,
        y:a.y+(b.y-a.y)*ratio
      };
    }

    travelled += segment;
  }

  return {...path[path.length-1]};
}

function addText(x,y,value,color="#fff"){
  state.texts.push({x,y,value,color,life:.8,maxLife:.8});
}

function addRing(x,y,color,start=5,end=40,life=.35){
  state.effects.push({
    type:"ring",
    x,y,color,
    radius:start,
    start,
    end,
    life,
    maxLife:life
  });
}

function addLine(x1,y1,x2,y2,color,life=.15,width=4){
  state.effects.push({
    type:"line",
    x1,y1,x2,y2,color,width,
    life,
    maxLife:life
  });
}

function addParticles(x,y,color,count=7,speed=70){
  for(let i=0;i<count;i++){
    const angle=Math.random()*Math.PI*2;
    const velocity=speed*(.25+Math.random()*.75);

    state.particles.push({
      x,y,
      vx:Math.cos(angle)*velocity,
      vy:Math.sin(angle)*velocity,
      color,
      radius:2+Math.random()*3,
      life:.3+Math.random()*.5,
      maxLife:.8
    });
  }
}

function muzzleFlash(tower){
  tower.recoil=.14;

  state.effects.push({
    type:"muzzle",
    x:tower.x+Math.cos(tower.angle)*28,
    y:tower.y+Math.sin(tower.angle)*28,
    color:getUnit(tower.type).color,
    life:.12,
    maxLife:.12
  });
}

function damageEnemy(enemy,amount,color="#fff",ignoreArmor=false){
  if(!enemy || enemy.dead) return;

  let damage=Number.isFinite(amount)?amount:0;

  if(enemy.armor && !ignoreArmor){
    damage *= 1-enemy.armor;
  }

  if(enemy.markedTimer>0){
    damage *= 1.35;
  }

  enemy.hp -= damage;

  addText(
    enemy.x,
    enemy.y-18,
    `-${Math.round(damage)}`,
    color
  );

  if(enemy.hp <= 0){
    enemy.dead=true;
    state.cash += enemy.reward || 0;

    addParticles(enemy.x,enemy.y,"#facc15",12,110);
    addRing(enemy.x,enemy.y,"#facc15",4,32,.3);
  }
}

/* ============================================================
   SELECTION SCREEN
============================================================ */
function renderMaps(){
  mapGrid.innerHTML="";

  for(const currentMap of MAPS){
    const card=document.createElement("div");
    card.className=
      "map-card"+
      (currentMap.hard ? " hard":"")+
      (state.mapId===currentMap.id ? " selected":"");

    const preview=document.createElement("canvas");
    preview.width=300;
    preview.height=120;
    const p=preview.getContext("2d");

    p.fillStyle="#17251a";
    p.fillRect(0,0,300,120);

    p.beginPath();
    p.moveTo(
      currentMap.path[0].x / 3.2,
      currentMap.path[0].y / 5
    );
    for(let i=1;i<currentMap.path.length;i++){
      p.lineTo(
        currentMap.path[i].x / 3.2,
        currentMap.path[i].y / 5
      );
    }
    p.lineCap="round";
    p.lineWidth=20;
    p.strokeStyle=currentMap.color;
    p.stroke();

    for(const obstacle of currentMap.obstacles){
      p.fillStyle="#7f2d2d";
      p.fillRect(
        obstacle.x / 3.2,
        obstacle.y / 5,
        obstacle.w / 3.2,
        obstacle.h / 5
      );
    }

    card.appendChild(preview);

    card.innerHTML += `
      <h3>${currentMap.name}${currentMap.hard ? " — HARD" : ""}</h3>
      <p>${currentMap.desc}</p>
    `;

    card.addEventListener("click",()=>{
      state.mapId=currentMap.id;
      rebuildPath();
      renderMaps();
    });

    mapGrid.appendChild(card);
