============================================================ */
const UNITS=[
  {id:"rifle",name:"Soldier",role:"Early",color:"#d6b85a",shape:"diamond",cost:225,range:145,damage:4,fireRate:6,description:"Reliable early-game tower.",pathA:"Light Machine Gun",pathB:"Double trouble",traitA:"Cooler gun.",traitB:"Three-shot experimental weapon.",bonuses:{A:{range:25,rate:.25},B:{rate:-.25,pellets:3,damage:.10}}},
  {id:"flame",name:"Flamethrower",role:"Early",color:"#fb923c",shape:"triangle",cost:325,range:90,damage:5,fireRate:12,description:"Fast close-range burning.",pathA:"Napalm",pathB:"Wide Flame",traitA:"Long burns and fire patches.",traitB:"Huge cone with knockback.",bonuses:{A:{damage:.3,burn:1.4},B:{range:25,cone:.25}}},
  {id:"shot",name:"Shotgunner",role:"Early",color:"#c084fc",shape:"square",cost:400,range:92,damage:30,fireRate:.75,description:"Close-range spread damage.",pathA:"Buckshot",pathB:"Slug Rounds",traitA:"Ten-pellet blast.",traitB:"Armor-breaking slug.",bonuses:{A:{damage:.32,pellets:2},B:{damage:.35,range:25}}},
  {id:"engineer",name:"Engineer",role:"Early",color:"#facc15",shape:"gear",cost:450,range:200,damage:17,fireRate:2,description:"Deploys combat turrets.",pathA:"Metal Shooter",pathB:"Minigun Platform",traitA:"Longer range metal rifle, adds a second rifle sentry.",traitB:"Adds a heavy minigun turret.",bonuses:{A:{damage:.75,range:40},B:{damage:.28,slow:.18}}},
  {id:"spike",name:"Spike Shooter",role:"Early",color:"#fb7185",shape:"spike",cost:275,range:82,damage:10,fireRate:1.15,description:"Fires spikes in every direction.",pathA:"Overdrive",pathB:"Nails",traitA:"Super-speed spike storm.",traitB:"Higher damage.",bonuses:{A:{rate:4,range:-30,damage:-.65},B:{damage:.60,range:40}}},
  {id:"mini",name:"Minigunner",role:"Mid",color:"#64748b",shape:"hex",cost:2500,range:160,damage:20,fireRate:10,description:"High sustained DPS.",pathA:"Armor Piercer",pathB:"Suppressor",traitA:"Higher damaging rounds.",traitB:"Long-barrel suppression.",bonuses:{A:{damage:.50,pierce:true},B:{rate:.28,slow:.2,range:25}}},
  {id:"frost",name:"Permafrost",role:"Mid",color:"#67e8f9",shape:"crystal",cost:4000,range:145,damage:20,fireRate:1.35,description:"Chilling two-round bursts.",pathA:"Cryo Control",pathB:"Frozen Barrage",traitA:"Freeze bomb every 24 shots.",traitB:"High freezing damage.",bonuses:{A:{range:35,rate:.35},B:{damage:1,rate:1.5}}},
  {id:"rocket",name:"Rocketeer",role:"Mid",color:"#f97316",shape:"long",cost:3500,range:155,damage:52,fireRate:2.1,description:"Reliable explosive damage.",pathA:"Warhead",pathB:"Guidance",traitA:"Secondary explosions.",traitB:"Split missiles.",bonuses:{A:{damage:.25,splash:35},B:{rate:.2,damage:.3}}},
  {id:"mortar",name:"Arsonist",role:"Mid",color:"#C23215",shape:"hex",cost:1500,range:245,damage:10,fireRate:4,description:"Experimental explosive bullets.",pathA:"Burning Shell",pathB:"Custom Switch",traitA:"Burning craters.",traitB:"Double barrage.",bonuses:{A:{rate:-.75,damage:.1500,splash:20},B:{rate:.1000,damage:-.10}}},
