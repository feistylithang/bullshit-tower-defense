  {id:"air",name:"Airstriker",role:"Late",color:"#93c5fd",shape:"radio",cost:21000,range:225,damage:115,fireRate:4,description:"Aircraft bombing runs.",pathA:"Carpet Bombing",pathB:"Napalm Run",traitA:"Three bombs.",traitB:"Burning zones.",bonuses:{A:{damage:-.5,bombs:3},B:{damage:.6,burn:4}}},
  {id:"support",name:"Rangemathingy",role:"Support",color:"#f0abfc",shape:"radio",cost:6500,range:130,damage:8,fireRate:1,description:"Increases nearby tower range.",pathA:"Long-Range Network",pathB:"Forward Observer",traitA:"Large range aura.",traitB:"Range and damage support.",bonuses:{A:{rangeAura:45},B:{rangeAura:30,damage:.12}}},
