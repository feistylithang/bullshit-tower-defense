<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Military Frontline Defense</title>
<style>
:root{
  --bg:#07100b;
  --panel:#172319;
  --panel2:#263a28;
  --line:#53694d;
  --text:#edf7ea;
  --muted:#a8bca2;
  --gold:#facc15;
  --green:#4ade80;
}

*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  font-family:Arial,sans-serif;
  background:
    radial-gradient(circle at top,#31482e,transparent 38%),
    linear-gradient(135deg,#07100b,#121c16);
}

button{
  border:0;
  border-radius:8px;
  padding:10px 13px;
  color:#fff;
  background:linear-gradient(#4b78b8,#315784);
  font-weight:bold;
  cursor:pointer;
}

button:hover:not(:disabled){filter:brightness(1.15)}
button:disabled{opacity:.45;cursor:not-allowed}

.screen{
  width:min(1240px,96vw);
  margin:22px auto;
  padding:20px;
  border:1px solid #455a43;
  border-radius:16px;
  background:#09110bf7;
  box-shadow:0 25px 80px #0008;
}

#gameScreen{display:none}

.header,.hud{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  flex-wrap:wrap;
}

h1{margin:0;font-size:clamp(26px,4vw,44px)}
h2{margin:18px 0 0}
.subtitle{margin-top:8px;color:var(--muted)}

.counter{
  padding:9px 15px;
  border:1px solid #6a805e;
  border-radius:999px;
  color:var(--gold);
  background:#ffffff12;
  font-weight:bold;
}

.map-grid,.unit-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:13px;
  margin:18px 0;
}

.map-card,.unit-card{
  padding:13px;
  border:2px solid #ffffff21;
  border-radius:12px;
  background:linear-gradient(145deg,#263a28,#142016);
  cursor:pointer;
}

.map-card.selected,.unit-card.selected{
  border-color:var(--green);
  box-shadow:0 0 0 2px #4ade8033;
}

.map-card.hard{border-color:#994848}

.map-card canvas{
  display:block;
  width:100%;
  height:120px;
  border-radius:7px;
  background:#17251a;
}

.map-card h3{margin:9px 0 4px}
.map-card p{margin:0;color:var(--muted);font-size:12px}

.unit-card{min-height:165px}
.unit-title{
  display:flex;
  align-items:center;
  gap:7px;
  font-size:16px;
}
.dot{
  width:17px;height:17px;border:2px solid #fff;border-radius:50%;
}
.role{
  margin-left:auto;
  padding:3px 5px;
  border-radius:4px;
  background:#facc15;
  color:#111;
  font-size:9px;
  font-weight:bold;
}
.desc{
  min-height:37px;
  margin-top:8px;
  color:var(--muted);
  font-size:12px;
}
.stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4px;
  color:#dbeafe;
  font-size:11px;
}
.paths{
  margin-top:7px;
  color:#c4b5fd;
  font-size:11px;
}
.right{display:flex;justify-content:flex-end}
.primary{
  background:linear-gradient(#facc15,#ca8a04);
  color:#211700;
  font-size:16px;
}
.hud{margin-bottom:13px}
.hud-stats{display:flex;gap:8px;flex-wrap:wrap}
.stat{
  min-width:90px;
  padding:8px 11px;
  background:#ffffff12;
  border:1px solid #ffffff21;
  border-radius:9px;
}
.label{
  color:var(--muted);
  font-size:10px;
  text-transform:uppercase;
}
.value{
  font-size:21px;
  font-weight:bold;
}
.hud-buttons{display:flex;gap:8px}
#speedButton.active{background:linear-gradient(#22c55e,#15803d)}

.layout{
  display:flex;
  align-items:flex-start;
  gap:13px;
}
.sidebar{
  width:265px;
  flex:0 0 265px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.panel{
  padding:11px;
  border:1px solid var(--line);
  border-radius:10px;
  background:linear-gradient(145deg,var(--panel2),var(--panel));
}
.panel-title{
  margin-bottom:8px;
  color:var(--muted);
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.build{
  display:flex;
  flex-direction:column;
  gap:6px;
}
.build button{
  display:flex;
  justify-content:space-between;
  text-align:left;
  background:#ffffff0d;
  border:1px solid #ffffff1a;
}
.build button.active{border-color:var(--green)}
#towerInfoPanel{display:none}
#towerInfoPanel.visible{display:block}
.info{
  color:var(--muted);
  font-size:12px;
  line-height:1.55;
}
.info strong{color:#fff}
.bonus{
  margin-top:7px;
  padding:7px;
  border:1px solid #86efac55;
  border-radius:6px;
  color:#bbf7d0;
  font-size:11px;
}
.path-buttons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:6px;
  margin-top:8px;
}
.path-buttons button{
  padding:8px 3px;
  background:linear-gradient(#7c3aed,#5b21b6);
  font-size:10px;
}
.path-buttons .selected{outline:2px solid var(--gold)}
.upgrade{width:100%;margin-top:8px;background:#2563eb}
.sell{width:100%;margin-top:6px;background:#b91c1c}
.tip{
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}
.canvas-box{
  flex:1;
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:12px;
}
#board{
  display:block;
  width:100%;
  height:auto;
  background:#101912;
}
@media(max-width:850px){
  .layout{flex-direction:column}
  .sidebar{width:100%;flex-basis:auto}
  .build{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
  }
}
</style>
</head>
<body>

<section id="selectScreen" class="screen">
  <div class="header">
    <div>
      <h1>Military Frontline Defense</h1>
      <div class="subtitle">Choose a battlefield and exactly five units.</div>
    </div>
    <div id="selectionCount" class="counter">0 / 5 selected</div>
  </div>

  <h2>Battlefield</h2>
  <div id="mapGrid" class="map-grid"></div>

  <h2>Military Roster</h2>
  <div id="unitGrid" class="unit-grid"></div>

  <div class="right">
    <button id="startButton" class="primary" disabled>Deploy Units</button>
  </div>
</section>

<section id="gameScreen" class="screen">
  <div class="hud">
    <div class="hud-stats">
      <div class="stat"><div class="label">Funds</div><div id="moneyText" class="value">450</div></div>
      <div class="stat"><div class="label">Lives</div><div id="lifeText" class="value">20</div></div>
      <div class="stat"><div class="label">Wave</div><div id="waveText" class="value">1</div></div>
      <div class="stat"><div class="label">Speed</div><div id="speedText" class="value">1×</div></div>
    </div>

    <div class="hud-buttons">
      <button id="speedButton">2× Speed</button>
      <button id="waveButton" class="primary">Start Wave</button>
    </div>
  </div>

  <div class="layout">
    <aside class="sidebar">
      <div class="panel">
        <div class="panel-title">Deploy Units</div>
        <div id="buildList" class="build"></div>
      </div>

      <div id="towerInfoPanel" class="panel">
        <div class="panel-title">Unit Command</div>
        <div id="towerInfo" class="info"></div>

        <div class="path-buttons">
          <button id="pathAButton" type="button">Path A</button>
          <button id="pathBButton" type="button">Path B</button>
        </div>

        <button id="upgradeButton" class="upgrade" type="button">Upgrade</button>
        <button id="sellButton" class="sell" type="button">Sell Unit</button>
      </div>

      <div class="panel tip">
        Towers attack automatically once enemies enter their range. The Economy Officer pays
        1,500g after every completed wave at level 1, and each upgrade boosts that income by around one-third of the tower's base cost.
      </div>
    </aside>

    <div class="canvas-box">
      <canvas id="board" width="960" height="600"></canvas>
    </div>
  </div>
</section>

