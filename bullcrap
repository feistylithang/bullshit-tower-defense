function pointSegmentDistance(px,py,x1,y1,x2,y2){
  const dx=x2-x1;
  const dy=y2-y1;
  const length=dx*dx+dy*dy;

  if(!length){
    return distance(px,py,x1,y1);
  }

  const ratio=clamp(
    ((px-x1)*dx + (py-y1)*dy)/length,
    0,
    1
  );

  return distance(
    px,
    py,
    x1+dx*ratio,
    y1+dy*ratio
  );
}

function isBlocked(x,y){
  if(x<25 || x>board.width-25) return true;
  if(y<25 || y>board.height-25) return true;

  for(let i=0;i<activeMap.path.length-1;i++){
    const a=activeMap.path[i];
    const b=activeMap.path[i+1];
    if(pointSegmentDistance(x,y,a.x,a.y,b.x,b.y) < 43){
      return true;
    }
  }

  for(const obstacle of activeMap.obstacles){
    if(
      x > obstacle.x-20 &&
      x < obstacle.x + obstacle.w + 20 &&
      y > obstacle.y-20 &&
      y < obstacle.y + obstacle.h + 20
    ){
      return true;
    }
  }

  return state.towers.some(tower =>
    distance(x,y,tower.x,tower.y) < 42
  );
}

function placeTower(x,y){
  const selectedId = state.buildType;
  if(!selectedId) return;

  const currentUnit=getUnit(selectedId);
  if(!currentUnit){
    state.buildType=null;
    renderBuildList();
    return;
  }

  if(state.cash < currentUnit.cost){
    addText(x,y,"Not enough funds","#ef4444");
    return;
  }

  if(isBlocked(x,y)){
    addText(x,y,"Cannot deploy here","#ef4444");
    return;
  }

  const tower={
    id:Date.now()+Math.random(),
    type:currentUnit.id,
    x,y,
    level:1,
    path:null,

    base:currentUnit.cost,
    spent:currentUnit.cost,

    cooldown:0,
    attacks:0,
    angle:0,
    recoil:0,
    spin:0,

    charge:0,
    beam:false,
    beamTarget:null,

    burst:0,
    burstTimer:0,
    shots:0,
    hits:new Map(),

    turrets:[],
    incomeTimer:0,
    totalIncome:0
  };

  state.towers.push(tower);
  state.cash -= currentUnit.cost;

  state.buildType=null;
  state.selectedTower=tower;

  addRing(x,y,currentUnit.color,5,42,.45);
  addParticles(x,y,currentUnit.color,15,90);

  renderBuildList();
  updateTowerPanel();
  updateHUD();
}

board.addEventListener("click",(event)=>{
  const rect=board.getBoundingClientRect();

  const x=Math.round(
    ((event.clientX-rect.left) * board.width / rect.width) / 10
  )*10;

  const y=Math.round(
    ((event.clientY-rect.top) * board.height / rect.height) / 10
  )*10;

  if(state.buildType){
    placeTower(x,y);
    return;
  }

  state.selectedTower =
    state.towers.find(tower =>
      distance(x,y,tower.x,tower.y) <= 25
    ) || null;

  updateTowerPanel();
});

/* ============================================================
   UPGRADE INFO
============================================================ */
function getPathBonuses(tower){
  if(!tower || !tower.path) return {};

  const currentUnit=getUnit(tower.type);
  const data = currentUnit.bonuses[tower.path];

  if(!data) return {};

  const result={};

  for(let level=3; level<=tower.level; level++){
    Object.assign(result, data);
  }

  return result;
}

function getStats(tower){
  const currentUnit=getUnit(tower.type);
  const bonus=getPathBonuses(tower);

  let damage=currentUnit.damage * (1 + (tower.level-1)*.35);
  let range=currentUnit.range + (tower.level-1)*14;
  let rate=currentUnit.fireRate * (1 + (tower.level-1)*.18);

  damage *= 1 + (bonus.damage || 0);
  range += bonus.range || 0;
  rate *= 1 + (bonus.rate || 0);

  return {
    unit:currentUnit,
    damage,
    range,
    rate,
    bonus
  };
}

function getUpgradeCost(tower){
  return Math.floor(
    tower.base * (1.3 + tower.level*.98)
  );
}

function describeBonuses(bonus){
  const values=[];

  if(bonus.damage) values.push(`+${Math.round(bonus.damage*100)}% damage`);
  if(bonus.rate) values.push(`+${Math.round(bonus.rate*100)}% fire rate`);
  if(bonus.range) values.push(`+${bonus.range} range`);
  if(bonus.charge) values.push(`+${Math.round(bonus.charge*100)}% charge speed`);
  if(bonus.auraSpeed) values.push(`+${Math.round(bonus.auraSpeed*100)}% ally attack speed`);
  if(bonus.auraDamage) values.push(`+${Math.round(bonus.auraDamage*100)}% ally damage`);
  if(bonus.auraRange) values.push(`+${bonus.auraRange} ally range`);
  if(bonus.rangeAura) values.push(`+${bonus.rangeAura} range aura`);
  if(bonus.burn) values.push(`${bonus.burn}s burn`);
  if(bonus.slow) values.push("stronger slow");
  if(bonus.pierce) values.push("armor piercing");
  if(bonus.knock) values.push(`${bonus.knock} knockback`);
  if(bonus.bombs) values.push(`${bonus.bombs} bombs`);
  if(bonus.chain) values.push(`+${bonus.chain} chain targets`);
  if(bonus.freeze) values.push(`${bonus.freeze}s freeze`);
  if(bonus.pellets) values.push(`+${bonus.pellets} pellets`);
  if(bonus.heal) values.push(`+${bonus.heal} lives per wave`);
  if(bonus.incomeWave) values.push(`+${bonus.incomeWave} wave income`);
  if(bonus.incomeTick) values.push(`+${bonus.incomeTick} periodic income`);

  return values.length ? values.join("<br>") : "No path bonuses yet";
}

function getAcceleratorTime(tower){
  const bonus=getPathBonuses(tower);

  return Math.max(
    2.1,
    4 - (tower.level-1)*.48
  ) * (1 - (bonus.charge || 0) * .2);
}

function updateTowerPanel(){
  if(!state.selectedTower){
    towerInfoPanel.classList.remove("visible");
    return;
  }

  towerInfoPanel.classList.add("visible");

